# Entorno virtual y paquetes
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Copias de seguridad locales
.vida_backup_*/
*.backup*
*.bak*

# Datos generados (base local, evidencias, eventos, informes)
data/vida.db
data/users.db
data/.cert_token
data/evidence/
data/events/*.json
data/reports/*.json
certificates/*.issued.json
!certificates/.gitkeep

# Multimedia (materiales se sirven localmente; videos se versionan por deploy)
media/materials/*
!media/materials/.gitkeep

# SQLite temporales
*.db-journal
*.db-wal
*.db-shm

# Vercel
.vercel/

# Artefactos accidentales
os
*.ps
.vercel
.env*

# Backups y paginas en obra
portafolio.html
