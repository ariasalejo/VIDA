{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "250mb" }
    },
    {
      "src": "podcast_audio/podcast_*.mp3",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/media/podcast/(?<file>.*)",
      "dest": "/podcast_audio/$file"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}